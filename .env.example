# 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=

# 默认完全使用本地 Ollama，不需要 OpenAI API Key
MODEL_PROVIDER=ollama
OUTPUT_MODE=transcript
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# 回复“是”后的分析模型；默认使用千问。
ANALYSIS_MODEL=qwen3.5:9b
# 非中文字幕自动用千问完整翻译为简体中文，不进行总结或删减。
TRANSLATE_NON_CHINESE=1
TRANSLATION_MODEL=qwen3.5:9b
OLLAMA_NUM_CTX=32768

# 仅当 MODEL_PROVIDER=openai 或将来启用云端语音转写时需要
OPENAI_API_KEY=

# 可选：多个 Telegram 数字用户 ID，用英文逗号分隔。留空表示不限制。
# 先启动 Bot 并发送 /id 可查看自己的 ID。
ALLOWED_TELEGRAM_USER_IDS=

# 云端备用配置
OPENAI_SUMMARY_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 无独立字幕轨时，使用本地 Whisper 识别音频
ENABLE_AUDIO_FALLBACK=1
TRANSCRIPTION_PROVIDER=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=models/faster-whisper

# 某些 B 站视频需要登录 Cookie。可导出 Netscape 格式 cookies.txt 后填绝对路径。
BILIBILI_COOKIES_FILE=
# 登录 bilibili.com 所用的浏览器：edge、chrome 或 firefox
BILIBILI_COOKIES_FROM_BROWSER=firefox
# 通用名称；设置后优先于上面的旧名称。可填写 firefox、chrome、edge 等。
VIDEO_COOKIES_FROM_BROWSER=firefox
# 优先简体中文，其次其他中文和英文，避免 YouTube 下载几十种无关字幕。
SUBTITLE_LANGUAGES=zh-Hans,zh-CN,ai-zh,zh.*,en-US,en-GB,en.*

# 同时处理的视频数。个人使用建议 1。
MAX_CONCURRENT_JOBS=1
